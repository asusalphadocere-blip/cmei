{
  "rules": {
    "notes": {
      ".read": true,
      "$noteId": {
        ".write": true,
        "sec": {
          ".validate": "newData.isString()"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "votes": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "authorId": {
          ".validate": "newData.isString()"
        },
        "hidden": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": true
    },
    "history": {
      ".read": true,
      ".write": true
    }
  }
}
